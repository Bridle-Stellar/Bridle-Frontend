# Copy this file to .env and adjust for your setup.

# Base URL of a running Bridle Backend instance (no trailing slash).
VITE_BRIDLE_API_URL=http://localhost:8000

# Soroban RPC endpoint used to submit signed policy transactions after
# Freighter signs them. Must point at the same network as the Bridle
# Backend instance above (and match its SOROBAN_RPC_URL).
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Expected network passphrase. If Freighter is connected to a different
# network than this, the dashboard shows a "wrong network" warning instead
# of letting a policy change go out on the wrong chain. Must match Bridle
# Backend's NETWORK_PASSPHRASE.
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
